{
  "denhaag": {
    "accordion": {
      "font-family": {
        "value": "{basis.text.font-family.default}"
      },
      "margin-block-end": {
        "value": "{basis.space.block.3xl}"
      },
      "section": {
        "border": {
          "value": "1px solid {denhaag.color.grey.500}"
        },
        "content": {
          "background-color": {
            "value": "{denhaag.color.neutrals.white}"
          },
          "padding-block-end": {
            "value": "24px"
          },
          "padding-block-start": {
            "value": "24px"
          },
          "padding-inline-end": {
            "value": "16px"
          },
          "padding-inline-start": {
            "value": "16px"
          },
          "transition": {
            "value": "grid-template-rows 400ms ease-in-out"
          }
        },
        "header": {
          "background-color": {
            "value": "{denhaag.color.neutrals.white}"
          },
          "column-gap": {
            "value": "8px"
          },
          "cursor": {
            "value": "pointer"
          },
          "font-size": {
            "value": "18px"
          },
          "line-height": {
            "value": "24px"
          },
          "padding-block-end": {
            "value": "12px"
          },
          "padding-block-start": {
            "value": "12px"
          },
          "padding-inline-end": {
            "value": "16px"
          },
          "padding-inline-start": {
            "value": "16px"
          },
          "icon": {
            "color": {
              "value": "{denhaag.color.green.500}"
            },
            "transform": {
              "value": "rotate(0deg)"
            },
            "transition": {
              "value": "transform 400ms ease-in-out"
            },
            "expanded": {
              "transform": {
                "value": "rotate(180deg)"
              }
            }
          }
        },
        "description": {
          "color": {
            "value": "{denhaag.color.grey.700}"
          },
          "font-size": {
            "value": "inherit"
          }
        },
        "title": {
          "color": {
            "value": "{denhaag.color.green.500}"
          },
          "font-size": {
            "value": "inherit"
          }
        }
      }
    }
  }
}

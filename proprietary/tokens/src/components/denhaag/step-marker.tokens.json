        "border-color": { "value": "{denhaag.color.red.500}" },
        "color": { "value": "{denhaag.color.neutrals.white}" }
      },
      "connector": {
        "outline-width": { "value": "1px" },
        "not-checked": { "outline-color": { "value": "{denhaag.color.grey.300}" } },
        "checked": {
          "outline-color": { "value": "{denhaag.color.green.500}" }
        },
        "warning": {
          "outline-color": { "value": "{denhaag.color.orange.600}" }
        },
        "error": {
          "outline-color": { "value": "{denhaag.color.red.500}" }
        },
        "default": {
          "outline-color": { "value": "{denhaag.color.grey.300}" }

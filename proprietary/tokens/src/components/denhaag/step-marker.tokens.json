{
  "denhaag": {
    "step-marker": {
      "border-width": { "value": "2px" },
      "font-family": { "value": "{basis.text.font-family.default}" },
      "font-weight": { "value": "400" },
      "font-size": { "value": "{basis.text.font-size.sm}" },
      "margin": { "value": "0" },
      "padding": { "value": "12px" },
      "size": { "value": "32px" },
      "icon-size": { "value": "20px" },
      "nested": {
        "size": { "value": " 16px" },
        "icon-size": { "value": "10px" }
      },
      "checked": {
        "background-color": { "value": "{denhaag.color.neutrals.white}" },
        "border-color": { "value": "{denhaag.color.green.500}" },
        "color": { "value": "{denhaag.color.green.500}" }
      },
      "current": {
        "background-color": { "value": "{denhaag.color.green.500}" },
        "border-color": { "value": "{denhaag.color.green.500}" },
        "color": { "value": "{denhaag.color.neutrals.white}" },
        "nested": {
          "color": { "value": "{denhaag.color.green.500}" }
        }
      },
      "default": {
        "background-color": { "value": "{denhaag.color.grey.300}" },
        "border-color": { "value": "{denhaag.color.grey.300}" },
        "color": { "value": "{denhaag.color.neutrals.white}" },
        "nested": {
          "color": { "value": "{denhaag.color.grey.300}" }
        }
      },
      "disabled": {
        "background-color": { "value": "{denhaag.color.grey.100}" },
        "border-color": { "value": "{denhaag.color.grey.100}" },
        "color": { "value": "{denhaag.color.grey.600}" }
      },
      "not-checked": {
        "background-color": { "value": "{denhaag.color.neutrals.white}" },
        "border-color": { "value": "{denhaag.color.grey.300}" },
        "color": { "value": "{denhaag.color.grey.600}" }
      },
      "warning": {
        "background-color": { "value": "{denhaag.color.orange.600}" },
        "border-color": { "value": "{denhaag.color.orange.600}" },
        "color": { "value": "{denhaag.color.neutrals.white}" },
        "nested": {
          "background-color": { "value": "{denhaag.color.neutrals.white}" },
          "border-color": { "value": "{denhaag.color.orange.600}" }
        }
      },
      "error": {
